      <conv:InverseBoolConverter x:Key="InverseBool" />
      <conv:StringToVisibilityConverter x:Key="StringToVis" />
      <conv:NullToVisibilityConverter x:Key="NullToVis" />
      <conv:StatusToBrushConverter x:Key="StatusToBrush" />
      <conv:StatusToLabelConverter x:Key="StatusToLabel" />
      <conv:RiskToLabelConverter x:Key="RiskToLabel" />
      <conv:RiskToBrushConverter x:Key="RiskToBrush" />
      <conv:HexToBrushConverter x:Key="HexToBrush" />
