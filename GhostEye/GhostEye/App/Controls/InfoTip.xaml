<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Controls.InfoTip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" x:Name="Root" VerticalAlignment="Center" xmlns:controls="clr-namespace:GhostEye.App.Controls">
  <Grid>
    <ToggleButton Name="Trigger" Width="20" Height="20" Cursor="Hand" Focusable="True" IsHitTestVisible="{Binding IsOpen, ElementName=Pop, Converter={StaticResource InverseBool}}" ToolTip="{loc:Tr info.tooltip}">
      <Control.Template>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Bd" Background="#00FFFFFF" CornerRadius="10">
            <Viewbox Width="15" Height="15">
              <Canvas Width="24" Height="24">
                <Path Name="Glyph" Data="{StaticResource Icon.Info}" Stroke="{StaticResource TextDimBrush}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
              </Canvas>
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Value="{StaticResource AccentBrightBrush}" Property="Shape.Stroke" />
              <Setter TargetName="Bd" Value="{StaticResource AccentWashBrush}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Glyph" Value="{StaticResource AccentBrightBrush}" Property="Shape.Stroke" />
              <Setter TargetName="Bd" Value="{StaticResource AccentWashBrush}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Control.Template>
    </ToggleButton>
    <Popup Name="Pop" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" StaysOpen="False" VerticalOffset="6" IsOpen="{Binding IsChecked, ElementName=Trigger, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Trigger}">
      <Border MaxWidth="380" Margin="0,0,12,12" Padding="16,14" Background="{StaticResource PanelSunkBrush}" BorderBrush="{StaticResource LineHoverBrush}" BorderThickness="1" CornerRadius="10">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="4" />
        </UIElement.Effect>
        <StackPanel>
          <TextBlock Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Text="{Binding Header, ElementName=Root}" />
          <TextBlock Margin="0,10,0,2" Style="{StaticResource Tag}" Foreground="{StaticResource AccentBrightBrush}" Text="{loc:Tr info.whatItDoes}" />
          <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="{Binding Summary, ElementName=Root}" />
          <StackPanel Visibility="{Binding Details, ElementName=Root, Converter={StaticResource StringToVis}}">
            <TextBlock Margin="0,10,0,2" Style="{StaticResource Tag}" Foreground="{StaticResource AccentBrightBrush}" Text="{loc:Tr info.whatChanges}" />
            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="{Binding Details, ElementName=Root}" />
          </StackPanel>
          <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Footer, ElementName=Root}" Visibility="{Binding Footer, ElementName=Root, Converter={StaticResource StringToVis}}" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>