<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Controls.SpinningLogo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False" xmlns:controls="clr-namespace:GhostEye.App.Controls;assembly=GhostEye">
  <Grid>
    <Image Name="Frame" Source="/Assets/logo.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <ScaleTransform x:Name="PlaceholderScale" />
      </UIElement.RenderTransform>
    </Image>
    <Rectangle Name="Shine" Opacity="0">
      <Shape.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <Brush.RelativeTransform>
            <TranslateTransform x:Name="ShineOffset" />
          </Brush.RelativeTransform>
          <GradientStop Offset="0.36" Color="#00FFFFFF" />
          <GradientStop Offset="0.46" Color="#40FFFFFF" />
          <GradientStop Offset="0.5" Color="#A6FFFFFF" />
          <GradientStop Offset="0.54" Color="#40FFFFFF" />
          <GradientStop Offset="0.64" Color="#00FFFFFF" />
        </LinearGradientBrush>
      </Shape.Fill>
      <UIElement.OpacityMask>
        <ImageBrush x:Name="ShineMask" Stretch="Fill" />
      </UIElement.OpacityMask>
    </Rectangle>
  </Grid>
</UserControl>