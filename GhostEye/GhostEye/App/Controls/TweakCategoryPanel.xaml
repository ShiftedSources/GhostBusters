<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Controls.TweakCategoryPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels">
  <ContentControl Style="{StaticResource Card}" Padding="0">
    <StackPanel>
      <Button HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Click="OnHeaderClick">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="Bd" Background="#00FFFFFF" Padding="18,16">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Border.Background">
                  <Setter.Value>
                    <SolidColorBrush Color="#FFFFFF" Opacity="0.02" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Control.Template>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding Category.IconKey, Converter={StaticResource IconKey}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Canvas>
          </Viewbox>
          <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource H2}" Text="{Binding Category.Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Category.CountLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </StackPanel>
          <Viewbox Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <Path Name="Chevron" Data="{StaticResource Icon.Chevron}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <RotateTransform x:Name="ChevronRotation" CenterX="12" CenterY="12" />
                </UIElement.RenderTransform>
              </Path>
            </Canvas>
          </Viewbox>
        </Grid>
      </Button>
      <ItemsControl Name="RowsHost" ItemsSource="{Binding Category.Items, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding Category.IsExpanded, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
            <StackPanel>
              <Border Style="{StaticResource RowDivider}" />
              <Grid Margin="18,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <WrapPanel>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" TextWrapping="Wrap">
                      <Run Text="{Binding Name, Mode=OneWay}" /> <InlineUIContainer BaselineAlignment="Center"><controls:InfoTip Margin="4,0,0,0" Details="{Binding Details}" Footer="{Binding InfoFooter}" Header="{Binding Name}" Summary="{Binding Description}" /></InlineUIContainer></TextBlock>
                    <Border Margin="9,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                      <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource WarnBrush}" Text="{loc:Tr badge.restart}" />
                    </Border>
                    <Border Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding IsAdvancedOnly, Converter={StaticResource BoolToVis}}">
                      <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource DangerBrush}" Text="{loc:Tr badge.advanced}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Description}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentDimBrush}" TextWrapping="Wrap" Text="{Binding UnavailableReason}" Visibility="{Binding UnavailableReason, Converter={StaticResource StringToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" Orientation="Horizontal">
                  <Border Margin="0,0,8,0" Padding="7,2" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding HasStateLabel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource AccentDimBrush}" Text="{Binding StateLabel}" />
                  </Border>
                  <Border Padding="7,2" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrush}}">
                    <TextBlock Style="{StaticResource Tag}" Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" Text="{Binding Risk, Converter={StaticResource RiskToLabel}}" />
                  </Border>
                </StackPanel>
                <ToggleButton Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsApplicable}" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ContentControl>
</UserControl>