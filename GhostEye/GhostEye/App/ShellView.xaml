<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.ShellView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:views="clr-namespace:GhostEye.App.Views" xmlns:app="clr-namespace:GhostEye.App">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:DashboardViewModel}}" DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:AnalyzerViewModel}}" DataType="{x:Type vm:AnalyzerViewModel}">
        <views:AnalyzerView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:OptimizeViewModel}}" DataType="{x:Type vm:OptimizeViewModel}">
        <views:OptimizeView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:GamingViewModel}}" DataType="{x:Type vm:GamingViewModel}">
        <views:GamingView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:NetworkPageViewModel}}" DataType="{x:Type vm:NetworkPageViewModel}">
        <views:NetworkView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:PrivacyViewModel}}" DataType="{x:Type vm:PrivacyViewModel}">
        <views:PrivacyView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:SoftwareViewModel}}" DataType="{x:Type vm:SoftwareViewModel}">
        <views:SoftwareView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:InterfaceViewModel}}" DataType="{x:Type vm:InterfaceViewModel}">
        <views:PrivacyView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:CleanupViewModel}}" DataType="{x:Type vm:CleanupViewModel}">
        <views:CleanupView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:StartupViewModel}}" DataType="{x:Type vm:StartupViewModel}">
        <views:StartupView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:AppsViewModel}}" DataType="{x:Type vm:AppsViewModel}">
        <views:AppsView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:ServicesViewModel}}" DataType="{x:Type vm:ServicesViewModel}">
        <views:ServicesView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:ToolsViewModel}}" DataType="{x:Type vm:ToolsViewModel}">
        <views:ToolsView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:DiskViewModel}}" DataType="{x:Type vm:DiskViewModel}">
        <views:DiskView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:HealthViewModel}}" DataType="{x:Type vm:HealthViewModel}">
        <views:HealthView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:HistoryViewModel}}" DataType="{x:Type vm:HistoryViewModel}">
        <views:HistoryView />
      </DataTemplate>
      <DataTemplate x:Key="{DataTemplateKey {x:Type vm:SettingsViewModel}}" DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="{StaticResource FontBody}" TextElement.FontSize="13">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="16,18,16,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,22">
            <controls:SpinningLogo x:Name="Logo" Width="38" Height="38" />
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource H2}" FontSize="15" Text="GhostEye" />
              <TextBlock Style="{StaticResource Tag}" Text="{Binding BrandSubtitle}" />
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl Name="NavList" ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                  <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                          <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding IconKey, Converter={StaticResource IconKey}}" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </Canvas>
                      </Viewbox>
                      <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" Text="{Binding Label}" />
                    </StackPanel>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Grid Row="2" Margin="4,16,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource GoodBrush}" />
              <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource Tag}" Text="{Binding StatusLine}" />
            </StackPanel>
            <Button Name="Pumpkin" Width="22" Height="22" Margin="0,0,-4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Visibility="Collapsed" ToolTip="{loc:Tr halloween.tooltip}" Click="OnPumpkinClick">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Grid Name="Face" Background="#00FFFFFF" Opacity="0.35" RenderTransformOrigin="0.5,0.6">
                    <UIElement.RenderTransform>
                      <ScaleTransform x:Name="Grow" ScaleX="1" ScaleY="1" />
                    </UIElement.RenderTransform>
                    <UIElement.Effect>
                      <DropShadowEffect x:Name="Glow" BlurRadius="12" Color="#FF8A1F" Opacity="0" ShadowDepth="0" />
                    </UIElement.Effect>
                    <Viewbox>
                      <Canvas Width="24" Height="24">
                        <Path Data="M12,6.2 C11.8,4.2 12.6,2.6 14.4,1.8" Stroke="#6FA34A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="2.2" Canvas.Top="6" Width="11" Height="15.5" Fill="#D9601A" />
                        <Ellipse Canvas.Left="10.8" Canvas.Top="6" Width="11" Height="15.5" Fill="#D9601A" />
                        <Ellipse Canvas.Left="6.5" Canvas.Top="5.4" Width="11" Height="16.4">
                          <Shape.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Offset="0" Color="#FFA24A" />
                              <GradientStop Offset="1" Color="#F07A1C" />
                            </LinearGradientBrush>
                          </Shape.Fill>
                        </Ellipse>
                        <Path Data="M7.4,11.6 L9.8,9.4 L10.6,12.4 M16.6,11.6 L14.2,9.4 L13.4,12.4 M7,15 L9,16 L10.5,15 L12,16.2 L13.5,15 L15,16 L17,15 C16.2,17.8 13.9,18.9 12,18.9 C10.1,18.9 7.8,17.8 7,15" Fill="#2A1204" />
                      </Canvas>
                    </Viewbox>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <TriggerBase.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.2" />
                          </Storyboard>
                        </BeginStoryboard>
                      </TriggerBase.EnterActions>
                      <TriggerBase.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Face" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                          </Storyboard>
                        </BeginStoryboard>
                      </TriggerBase.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Button>
          </Grid>
        </Grid>
      </Border>
      <Grid Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Row="0" Height="34" Background="#00FFFFFF" MouseLeftButtonDown="OnTitleBarDrag">
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}" ToolTip="{loc:Tr common.minimize}" Click="OnMinimize">
              <Viewbox Width="15" Height="15">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource Icon.Minimize}" StrokeThickness="1.6" StrokeStartLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource CaptionButton}" ToolTip="{loc:Tr common.maximize}" Click="OnMaximize">
              <Viewbox Width="13" Height="13">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource Icon.Maximize}" StrokeThickness="1.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" ToolTip="{loc:Tr common.close}" Click="OnClose">
              <Viewbox Width="14" Height="14">
                <Canvas Width="24" Height="24">
                  <Path Data="{StaticResource Icon.Close}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>
        <Grid Row="1" Margin="28,4,28,18">
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
          </StackPanel>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" Background="{StaticResource PanelSunkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}">
            <TextBlock Style="{StaticResource Tag}" Text="{Binding ElevationBadge}" />
          </Border>
        </Grid>
        <ContentControl Name="PageHost" Grid.Row="2" Margin="28,0,20,0" RenderTransformOrigin="0.5,0.5" Content="{Binding CurrentPage}">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>
        </ContentControl>
      </Grid>
    </Grid>
    <Grid Name="DialogLayer" Background="#B4050810" Visibility="{Binding Dialogs.IsOpen, Converter={StaticResource BoolToVis}}">
      <ContentControl MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="24">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="{Binding Dialogs.Title}" />
          <TextBlock Margin="0,10,0,0" Style="{StaticResource Body}" Foreground="{StaticResource TextDimBrush}" Text="{Binding Dialogs.Message}" />
          <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,10,0" Style="{StaticResource GhostButton}" Command="{Binding Dialogs.CancelCommand}" Content="{Binding Dialogs.CancelText}" Visibility="{Binding Dialogs.HasCancel, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding Dialogs.PrimaryCommand}" Content="{Binding Dialogs.PrimaryText}" Visibility="{Binding Dialogs.IsDestructive, Converter={StaticResource InverseBoolToVis}}" />
            <Button Style="{StaticResource DangerButton}" Command="{Binding Dialogs.PrimaryCommand}" Content="{Binding Dialogs.PrimaryText}" Visibility="{Binding Dialogs.IsDestructive, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
      </ContentControl>
    </Grid>
  </Grid>
</UserControl>