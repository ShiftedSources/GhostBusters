<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.OptimizeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:views="clr-namespace:GhostEye.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" Padding="0,0,8,0">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PresetViewModel}">
              <ToggleButton Width="168" Margin="0,0,12,12" Style="{StaticResource ChipToggle}" Tag="{Binding}" Click="OnPresetClick">
                <StackPanel>
                  <Viewbox Width="20" Height="20" HorizontalAlignment="Left">
                    <Canvas Width="24" Height="24">
                      <Path StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{Binding IconKey, Converter={StaticResource IconKey}}" Stroke="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Margin="0,9,0,0" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                  <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Description}" />
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:TweakCategoryPanel Margin="0,4,0,0" Category="{Binding Categories[0]}" />
        <controls:TweakCategoryPanel Margin="0,16,0,0" Category="{Binding Categories[1]}" />
        <controls:TweakCategoryPanel Margin="0,16,0,0" Category="{Binding Categories[2]}" />
        <TextBlock Margin="2,16,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding ResultMessage}" Visibility="{Binding ResultMessage, Converter={StaticResource StringToVis}}" />
        <Border Height="16" Background="#00FFFFFF" />
      </StackPanel>
    </ScrollViewer>
    <ContentControl Grid.Row="1" Margin="0,14,8,18" Padding="18,14" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Style="{StaticResource Body}" Text="{Binding SelectionSummary}" Visibility="{Binding SelectionSummary, Converter={StaticResource StringToVis}}" />
          <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Content="{loc:Tr common.applyChanges}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </Grid>
    </ContentControl>
  </Grid>
</UserControl>