<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.AnalyzerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:models="clr-namespace:GhostEye.Core.Models;assembly=GhostEye.Core" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <StackPanel>
      <ContentControl Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr analyzer.title}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{loc:Tr analyzer.description}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}" Content="{loc:Tr common.startAnalysis}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}" Visibility="{Binding EmptyMessage, Converter={StaticResource StringToVis}}">
        <TextBlock Style="{StaticResource Caption}" Text="{Binding EmptyMessage}" />
      </ContentControl>
      <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:AnalysisGroupViewModel}">
            <ContentControl Margin="0,0,0,16" Style="{StaticResource Card}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                  <TextBlock HorizontalAlignment="Right" Style="{StaticResource Tag}" Text="{Binding CountLabel}" />
                </Grid>
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AnalysisItem}">
                      <StackPanel>
                        <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />
                        <Grid Margin="0,12,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Description}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Metric}" Text="{Binding Measurement}" />
                          <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Tag}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" Text="{Binding Status, Converter={StaticResource StatusToLabel}}" />
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ContentControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>