<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.ServicesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" x:Name="Page" xmlns:views="clr-namespace:GhostEye.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="SystemRow" DataType="{x:Type vm:SystemItemViewModel}">
        <StackPanel>
          <Border Style="{StaticResource RowDivider}" />
          <Grid Margin="18,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                <controls:InfoTip Margin="6,0,0,0" Details="{Binding Details}" Footer="{Binding InfoFooter}" Header="{Binding Name}" Summary="{Binding Description}" />
              </StackPanel>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}" Text="{Binding Description}" />
              <TextBlock Margin="0,3,0,0" Style="{StaticResource Tag}" Text="{Binding StateLabel}" />
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
            </StackPanel>
            <Border Grid.Column="1" Margin="0,0,14,0" Padding="7,2" VerticalAlignment="Center" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" BorderBrush="{Binding Risk, Converter={StaticResource RiskToBrush}}">
              <TextBlock Style="{StaticResource Tag}" Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" Text="{Binding Risk, Converter={StaticResource RiskToLabel}}" />
            </Border>
            <ToggleButton Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" Command="{Binding ToggleCommand}" CommandParameter="{Binding}" IsChecked="{Binding IsOptimized, Mode=OneWay}" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
          </Grid>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer Padding="0,0,8,0">
    <StackPanel>
      <ContentControl Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr services.title}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr services.hint}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr services.adminHint}" Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Content="{loc:Tr common.refresh}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Margin="18,16" Style="{StaticResource H2}" Text="{loc:Tr services.section.services}" />
          <ItemsControl ItemTemplate="{StaticResource SystemRow}" ItemsSource="{Binding Services}" />
        </StackPanel>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Margin="18,16" Style="{StaticResource H2}" Text="{loc:Tr services.section.tasks}" />
          <ItemsControl ItemTemplate="{StaticResource SystemRow}" ItemsSource="{Binding Tasks}" />
        </StackPanel>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="18,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Style="{StaticResource H2}" Text="{loc:Tr services.backup.title}" />
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr services.backup.hint}" />
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding BackupMessage}" Visibility="{Binding BackupMessage, Converter={StaticResource StringToVis}}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" Content="{loc:Tr services.backup.create}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>
          <TextBlock Margin="18,0,18,16" Style="{StaticResource Caption}" Text="{loc:Tr services.backup.empty}" Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVis}}" />
          <ItemsControl ItemsSource="{Binding Backups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ServiceBackupItemViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Grid Margin="18,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding DateLabel}" />
                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource AccentDimBrush}" Text="{Binding KindLabel}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Meta}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Margin="0,0,8,0" Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding DataContext.DeleteBackupCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.delete}" IsEnabled="{Binding DataContext.IsBusy, ElementName=Page, Converter={StaticResource InverseBool}}" />
                      <Button Padding="10,6" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.RestoreBackupCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.restore}" IsEnabled="{Binding DataContext.IsBusy, ElementName=Page, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
      <Border Height="16" Background="#00FFFFFF" />
    </StackPanel>
  </ScrollViewer>
</UserControl>