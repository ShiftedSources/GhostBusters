<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.HealthView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" x:Name="Page" xmlns:views="clr-namespace:GhostEye.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="GaugeTile" DataType="{x:Type vm:GaugeViewModel}">
        <Border Margin="0,0,10,0" Padding="14,12" BorderThickness="1" Background="{StaticResource PanelSunkBrush}" BorderBrush="{StaticResource LineBrush}" CornerRadius="{StaticResource ControlRadius}">
          <StackPanel>
            <TextBlock Style="{StaticResource Tag}" Text="{Binding Label}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource MetricLarge}" Text="{Binding Value}" />
            <ContentControl Margin="0,8,0,0" Style="{StaticResource MeterBar}" Tag="{Binding Ratio}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <Style x:Key="LevelBadge" TargetType="{x:Type Border}">
        <Setter Property="Border.Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{StaticResource BadgeRadius}" />
        <Setter Property="BorderBrush" Value="{Binding Level, Converter={StaticResource HealthToBrush}}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer Padding="0,0,8,20">
    <StackPanel>
      <ContentControl Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr health.monitor.title}" />
              <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr health.monitor.title}" Summary="{loc:Tr health.monitor.info}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Content="{loc:Tr common.refresh}" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" />
          </Grid>
          <UniformGrid Margin="0,14,-10,0" Columns="5">
            <ContentControl ContentTemplate="{StaticResource GaugeTile}" Content="{Binding Cpu}" />
            <ContentControl ContentTemplate="{StaticResource GaugeTile}" Content="{Binding Memory}" />
            <ContentControl ContentTemplate="{StaticResource GaugeTile}" Content="{Binding Gpu}" />
            <ContentControl ContentTemplate="{StaticResource GaugeTile}" Content="{Binding DiskActivity}" />
            <ContentControl ContentTemplate="{StaticResource GaugeTile}" Content="{Binding Network}" />
          </UniformGrid>
          <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
          <Grid Margin="0,8,0,0" Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr health.adminHint}" />
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RestartAsAdminCommand}" Content="{loc:Tr admin.restart}" />
          </Grid>
        </StackPanel>
      </ContentControl>
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ContentControl VerticalAlignment="Top" Padding="0" Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Margin="18,16" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr health.disk.title}" />
              <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr health.disk.title}" Summary="{loc:Tr health.disk.info}" />
            </StackPanel>
            <Border Style="{StaticResource RowDivider}" Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}" />
            <Grid Margin="18,11" Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr health.disk.adminNeeded}" />
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RestartAsAdminCommand}" Content="{loc:Tr admin.restart}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Disks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DiskHealthViewModel}">
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="18,11">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Kind}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Details}" />
                      </StackPanel>
                      <Border Grid.Column="1" Style="{StaticResource LevelBadge}">
                        <TextBlock Style="{StaticResource Tag}" Foreground="{Binding Level, Converter={StaticResource HealthToBrush}}" Text="{Binding LevelLabel}" />
                      </Border>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ContentControl>
        <ContentControl Grid.Column="2" VerticalAlignment="Top" Padding="0" Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="18,16">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr health.security.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr health.security.title}" Summary="{loc:Tr health.security.info}" />
              </StackPanel>
              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Metric}" Text="{Binding SecuritySummary}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Security}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SecurityCheckViewModel}">
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="18,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                          <controls:InfoTip Margin="6,0,0,0" Header="{Binding Name}" Summary="{Binding Description}" />
                        </StackPanel>
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Detail}" />
                      </StackPanel>
                      <Border Grid.Column="1" Style="{StaticResource LevelBadge}">
                        <TextBlock Style="{StaticResource Tag}" Foreground="{Binding Level, Converter={StaticResource HealthToBrush}}" Text="{Binding LevelLabel}" />
                      </Border>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Margin="18,12,18,16" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Command="{Binding OpenSecuritySettingsCommand}" Content="{loc:Tr health.security.open}" />
          </StackPanel>
        </ContentControl>
      </Grid>
      <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr health.repair.title}" />
            <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr health.repair.title}" Summary="{loc:Tr health.repair.info}" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr health.repair.hint}" />
          <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunSfcCommand}" Content="{loc:Tr health.repair.sfc.button}" IsEnabled="{Binding IsRepairing, Converter={StaticResource InverseBool}}" />
            <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding RunDismCommand}" Content="{loc:Tr health.repair.dism.button}" IsEnabled="{Binding IsRepairing, Converter={StaticResource InverseBool}}" />
            <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding CancelRepairCommand}" Content="{loc:Tr common.cancel}" Visibility="{Binding IsRepairing, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Margin="0,14,0,0" Visibility="{Binding RepairStatus, Converter={StaticResource StringToVis}}">
            <TextBlock Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Text="{Binding RepairStatus}" />
            <ProgressBar Height="6" Margin="0,8,0,0" Background="{StaticResource PanelSunkBrush}" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Maximum="100" Value="{Binding RepairPercent, Mode=OneWay}" Visibility="{Binding IsRepairing, Converter={StaticResource BoolToVis}}" />
            <TextBox MaxHeight="140" Margin="0,10,0,0" FontSize="11" IsReadOnly="True" Style="{StaticResource AccentTextBox}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding RepairLog, Mode=OneWay}" Visibility="{Binding RepairLog, Converter={StaticResource StringToVis}}" />
          </StackPanel>
        </StackPanel>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="18,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr health.driver.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr health.driver.title}" Summary="{loc:Tr health.driver.info}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding DriverSummary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <CheckBox Style="{StaticResource AccentCheck}" IsChecked="{Binding ShowOnlyOldDrivers, Mode=TwoWay}" />
              <TextBlock Margin="8,0,16,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{loc:Tr health.driver.onlyOld}" />
              <Button Style="{StaticResource GhostButton}" Command="{Binding OpenWindowsUpdateCommand}" Content="{loc:Tr health.driver.windowsUpdate}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding VisibleDrivers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DriverViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Grid Margin="18,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource AccentDimBrush}" Text="{Binding ClassLabel}" />
                        </Border>
                        <Border Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding IsOld, Converter={StaticResource BoolToVis}}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource WarnBrush}" Text="{loc:Tr health.driver.old}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Detail}" />
                    </StackPanel>
                    <Button Grid.Column="2" Padding="10,6" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenDriverDownloadCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr health.driver.update}" Visibility="{Binding IsOld, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>