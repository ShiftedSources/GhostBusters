<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.AppsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" x:Name="Page" xmlns:views="clr-namespace:GhostEye.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ContentControl Margin="0,0,8,16" Style="{StaticResource Card}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource H2}" Text="{Binding SummaryLabel}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr apps.hint}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr apps.usageHint}" Visibility="{Binding ShowUsageHint, Converter={StaticResource BoolToVis}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Content="{loc:Tr common.refresh}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox Style="{StaticResource AccentTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TextBoxPlaceholder}" Text="{loc:Tr common.search}" Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <CheckBox Style="{StaticResource AccentCheck}" IsChecked="{Binding OnlyUnused, Mode=TwoWay}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{loc:Tr apps.onlyUnused}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{loc:Tr apps.sortBy}" />
            <Button Padding="10,6" CommandParameter="size" Style="{StaticResource GhostButton}" Command="{Binding SortCommand}" Content="{loc:Tr apps.sort.size}" />
            <Button Margin="6,0,0,0" Padding="10,6" CommandParameter="lastUsed" Style="{StaticResource GhostButton}" Command="{Binding SortCommand}" Content="{loc:Tr apps.sort.lastUsed}" />
            <Button Margin="6,0,0,0" Padding="10,6" CommandParameter="name" Style="{StaticResource GhostButton}" Command="{Binding SortCommand}" Content="{loc:Tr apps.sort.name}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ContentControl>
    <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
      <StackPanel>
        <ContentControl Padding="0" Style="{StaticResource Card}">
          <ItemsControl ItemsSource="{Binding AppsView}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:InstalledAppViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Grid Margin="18,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox VerticalAlignment="Center" Style="{StaticResource AccentCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <Grid Column="1" Width="26" Height="26" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                      <Viewbox Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource Icon.Apps}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                      </Viewbox>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="10,0,16,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding IsUnused, Converter={StaticResource BoolToVis}}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource WarnBrush}" Text="{loc:Tr apps.badge.unused}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Publisher}" />
                      <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding DetailLabel}" />
                      <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Metric}" Text="{Binding SizeLabel}" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ContentControl>
        <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}" Visibility="{Binding HasStoreApps, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <StackPanel Margin="18,16" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr apps.store.title}" />
              <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr apps.store.title}" Summary="{loc:Tr apps.store.info}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding StoreApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StoreAppViewModel}">
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="18,11">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <CheckBox VerticalAlignment="Center" Style="{StaticResource AccentCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                      <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Description}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ContentControl>
        <Border Height="16" Background="#00FFFFFF" />
      </StackPanel>
    </ScrollViewer>
    <ContentControl Grid.Row="2" Margin="0,0,8,18" Padding="18,14" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource MetricLarge}" Text="{Binding SelectionLabel}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding ResultMessage}" Visibility="{Binding ResultMessage, Converter={StaticResource StringToVis}}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Command="{Binding RemoveSelectedCommand}" Content="{loc:Tr apps.uninstallSelected}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </Grid>
    </ContentControl>
  </Grid>
</UserControl>