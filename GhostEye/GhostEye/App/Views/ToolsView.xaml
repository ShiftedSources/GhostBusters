<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.ToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" x:Name="Page" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,0">
    <StackPanel>
      <ContentControl Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr tools.ram.title}" />
              <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr tools.ram.title}" Summary="{loc:Tr tools.ram.info}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyStrong}" Text="{Binding MemoryLabel}" />
            <ProgressBar Height="6" Margin="0,8,0,0" Background="{StaticResource PanelSunkBrush}" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Maximum="100" Value="{Binding MemoryPercent, Mode=OneWay}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding RamMessage}" Visibility="{Binding RamMessage, Converter={StaticResource StringToVis}}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Command="{Binding FreeMemoryCommand}" Content="{loc:Tr tools.ram.button}" IsEnabled="{Binding IsRamBusy, Converter={StaticResource InverseBool}}" />
        </Grid>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="18,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr tools.processes.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr tools.processes.title}" Summary="{loc:Tr tools.processes.info}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding ProcessMessage}" Visibility="{Binding ProcessMessage, Converter={StaticResource StringToVis}}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RefreshProcessesCommand}" Content="{loc:Tr common.refresh}" IsEnabled="{Binding IsProcessBusy, Converter={StaticResource InverseBool}}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Processes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ProcessItemViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Grid Margin="18,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="22" Height="22" HorizontalAlignment="Left" Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Metric}" Text="{Binding MemoryLabel}" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding CpuLabel}" />
                    <Button Grid.Column="4" Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding DataContext.EndProcessCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.endTask}" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr tools.dns.title}" />
              <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr tools.dns.title}" Summary="{loc:Tr tools.dns.info}" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding DnsMessage}" Visibility="{Binding DnsMessage, Converter={StaticResource StringToVis}}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding FlushDnsCommand}" Content="{loc:Tr tools.dns.button}" />
        </Grid>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="18,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr tools.files.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr tools.files.title}" Summary="{loc:Tr tools.files.info}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Text="{Binding FilesMessage}" Visibility="{Binding FilesMessage, Converter={StaticResource StringToVis}}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding FindLargeFilesCommand}" Content="{loc:Tr tools.files.button}" IsEnabled="{Binding IsFilesBusy, Converter={StaticResource InverseBool}}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding LargeFiles}" Visibility="{Binding HasLargeFiles, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:LargeFileViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Grid Margin="18,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                      <TextBlock Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Text="{Binding Folder}" ToolTip="{Binding Folder}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Metric}" Text="{Binding SizeLabel}" />
                      <TextBlock Style="{StaticResource Tag}" Text="{Binding DateLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenFileLocationCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.openLocation}" />
                      <Button Margin="6,0,0,0" Padding="10,6" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteFileCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.delete}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
      <Border Height="16" Background="#00FFFFFF" />
    </StackPanel>
  </ScrollViewer>
</UserControl>