<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:models="clr-namespace:GhostEye.Core.Models;assembly=GhostEye.Core" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ContentControl Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr dashboard.score.title}" />
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Tag}" Text="{loc:Tr dashboard.score.tag}" />
          </Grid>
          <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
            <Grid Width="176" Height="176">
              <Ellipse Width="148" Height="148" Stroke="{StaticResource LineBrush}" StrokeThickness="10" />
              <Path Name="ScoreArc" Stroke="{StaticResource ScoreArcBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource MetricHuge}" Text="{Binding ScoreLabel}" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Tag}" Text="{loc:Tr dashboard.score.outOf}" />
              </StackPanel>
            </Grid>
            <StackPanel Width="210" Margin="20,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding ScoreHeadline}" />
              <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="{Binding ScoreSubtitle}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" Content="{loc:Tr common.analyzeSystem}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding FixAllCommand}" Content="{loc:Tr common.fixAll}" IsEnabled="{Binding HasFindings}" />
          </StackPanel>
          <TextBlock Margin="0,16,0,0" Style="{StaticResource Caption}" Text="{loc:Tr dashboard.findings.empty}" Visibility="{Binding HasFindings, Converter={StaticResource InverseBoolToVis}}" />
          <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:AnalysisItem}">
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="7" Height="7" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Body}" FontSize="12.5" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
      <StackPanel Grid.Column="2">
        <ContentControl Margin="0,0,0,16" Style="{StaticResource Card}" Visibility="{Binding HasDrift, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Padding="6,2" VerticalAlignment="Center" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}">
                <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource WarnBrush}" Text="{loc:Tr drift.card.badge}" />
              </Border>
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource H2}" Text="{Binding DriftTitle}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr drift.card.body}" />
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DriftedNames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,2,0,0" Style="{StaticResource Body}" Text="{Binding StringFormat=·  {0}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding DriftMessage}" Visibility="{Binding DriftMessage, Converter={StaticResource StringToVis}}" />
            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
              <Button Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" Command="{Binding ReapplyDriftCommand}" Content="{loc:Tr drift.reapply}" IsEnabled="{Binding IsDriftBusy, Converter={StaticResource InverseBool}}" />
              <Button Style="{StaticResource GhostButton}" Command="{Binding DismissDriftCommand}" Content="{loc:Tr drift.dismiss}" IsEnabled="{Binding IsDriftBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
          </StackPanel>
        </ContentControl>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ContentControl Grid.Column="0" Style="{StaticResource CardSunk}">
            <StackPanel>
              <TextBlock Style="{StaticResource Tag}" Text="{loc:Tr dashboard.tile.cpu}" />
              <TextBlock Margin="0,7,0,0" Style="{StaticResource MetricLarge}" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuValue}" Text="{Binding CpuValue}" />
            </StackPanel>
          </ContentControl>
          <ContentControl Grid.Column="2" Style="{StaticResource CardSunk}">
            <StackPanel>
              <TextBlock Style="{StaticResource Tag}" Text="{loc:Tr dashboard.tile.ram}" />
              <TextBlock Margin="0,7,0,0" Style="{StaticResource MetricLarge}" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding RamValue}" Text="{Binding RamValue}" />
            </StackPanel>
          </ContentControl>
          <ContentControl Grid.Column="4" Style="{StaticResource CardSunk}">
            <StackPanel>
              <TextBlock Style="{StaticResource Tag}" Text="{loc:Tr dashboard.tile.gpu}" />
              <TextBlock Margin="0,7,0,0" Style="{StaticResource MetricLarge}" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuTooltip}" Text="{Binding GpuValue}" />
            </StackPanel>
          </ContentControl>
        </Grid>
        <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource H2}" Text="{loc:Tr dashboard.history.title}" />
              <TextBlock HorizontalAlignment="Right" Style="{StaticResource Tag}" Text="{loc:Tr dashboard.history.tag}" />
            </Grid>
            <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" Text="{loc:Tr dashboard.history.empty}" Visibility="{Binding HasRecentChanges, Converter={StaticResource InverseBoolToVis}}" />
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RecentChanges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChangeSetViewModel}">
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" Margin="0,10,0,0" />
                    <Grid Margin="0,11,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Meta}" />
                      </StackPanel>
                      <Button Grid.Column="1" Padding="8,4" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Command="{Binding DataContext.DeleteChangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{loc:Tr history.delete}">
                        <Viewbox Width="14" Height="14">
                          <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Margin="0,14,0,0" Style="{StaticResource LinkButton}" Command="{Binding OpenHistoryCommand}" Content="{loc:Tr dashboard.history.all}" Visibility="{Binding HasRecentChanges, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>