<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.StartupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" x:Name="Page" xmlns:views="clr-namespace:GhostEye.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ContentControl Margin="0,0,8,16" Style="{StaticResource Card}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0">
            <TextBlock Style="{StaticResource H2}" Text="{Binding SummaryLabel}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr startup.hint}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr startup.adminHint}" Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVis}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Content="{loc:Tr common.refresh}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox Style="{StaticResource AccentTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TextBoxPlaceholder}" Text="{loc:Tr common.search}" Visibility="{Binding SearchText, Converter={StaticResource StringToVis}, ConverterParameter=invert}" />
          </Grid>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <CheckBox Name="ShowMsCheck" Style="{StaticResource AccentCheck}" IsChecked="{Binding ShowMicrosoft, Mode=TwoWay}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{loc:Tr startup.showMicrosoft}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ContentControl>
    <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
      <StackPanel>
        <ContentControl Padding="0" Style="{StaticResource Card}">
          <ItemsControl ItemsSource="{Binding ItemsView}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left">
                      <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                      <Viewbox Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                        <Canvas Width="24" Height="24">
                          <Path Data="{StaticResource Icon.Startup}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                      </Viewbox>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="8,0,16,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <controls:InfoTip Margin="6,0,0,0" Header="{Binding Name}" Summary="{Binding InfoText}" Footer="{loc:Tr startup.info.footer}" />
                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource AccentDimBrush}" Text="{Binding SourceLabel}" />
                        </Border>
                        <Border Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding IsOrphan, Converter={StaticResource BoolToVis}}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource WarnBrush}" Text="{loc:Tr startup.badge.orphan}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Publisher}" Visibility="{Binding HasPublisher, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Text="{Binding Command}" ToolTip="{Binding Command}" />
                      <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Margin="0,0,8,0" Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenLocationCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.openLocation}" Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}" />
                      <Button Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RemoveCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.remove}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                      <Button Padding="10,6" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.RestoreCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.restore}" Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" Command="{Binding DataContext.ToggleCommand, ElementName=Page}" CommandParameter="{Binding}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ContentControl>
        <Border Height="16" Background="#00FFFFFF" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>