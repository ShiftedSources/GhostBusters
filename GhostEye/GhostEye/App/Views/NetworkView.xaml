<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.NetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ContentControl Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{Binding DnsTitle}" />
            <TextBlock Margin="0,18,0,0" Style="{StaticResource Caption}" Text="{Binding PrimaryLabel}" />
            <TextBox Margin="0,6,0,0" Style="{StaticResource AccentTextBox}" Text="{Binding PrimaryDns, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" Text="{Binding SecondaryLabel}" />
            <TextBox Margin="0,6,0,0" Style="{StaticResource AccentTextBox}" Text="{Binding SecondaryDns, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}" Text="{Binding DnsValidationMessage}" Visibility="{Binding DnsValidationMessage, Converter={StaticResource StringToVis}}" />
            <TextBlock Margin="0,16,0,0" Style="{StaticResource Caption}" Text="{loc:Tr network.dns.presets}" />
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,8,8" Style="{StaticResource GhostButton}" Command="{Binding DataContext.UsePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding Name}" ToolTip="{Binding Primary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,10,0,0">
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" Text="{loc:Tr network.dns.benchmark.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr network.dns.benchmark.title}" Summary="{loc:Tr network.dns.benchmark.info}" />
              </StackPanel>
              <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RunBenchmarkCommand}" Content="{loc:Tr network.dns.benchmark.button}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding BenchmarkStatus}" Visibility="{Binding BenchmarkStatus, Converter={StaticResource StringToVis}}" />
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding BenchmarkResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource StringToVis}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Text="{Binding Time}">
                        <FrameworkElement.Style>
                          <Style BasedOn="{StaticResource Metric}" TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsBest}">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                      <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Command="{Binding DataContext.UseBenchmarkResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{loc:Tr network.dns.benchmark.use}" Visibility="{Binding CanUse, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr network.dns.applyHint}" />
            <Border Margin="0,18,0,0" Padding="14" Background="{StaticResource PanelSunkBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
              <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" Text="{Binding DnsWarning}" />
            </Border>
          </StackPanel>
        </ContentControl>
        <StackPanel Grid.Column="2">
          <controls:TweakCategoryPanel Category="{Binding Tweaks.Category}" />
          <ContentControl Margin="0,16,0,0" Padding="18,14" Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Tweaks.SelectionSummary}" Visibility="{Binding Tweaks.SelectionSummary, Converter={StaticResource StringToVis}}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding Tweaks.ResultMessage}" Visibility="{Binding Tweaks.ResultMessage, Converter={StaticResource StringToVis}}" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding Tweaks.ApplyCommand}" Content="{loc:Tr common.apply}" IsEnabled="{Binding Tweaks.IsBusy, Converter={StaticResource InverseBool}}" />
            </Grid>
          </ContentControl>
        </StackPanel>
      </Grid>
      <Grid Margin="0,16,0,0" DataContext="{Binding Tools}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <ContentControl Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr network.speed.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr network.speed.title}" Summary="{loc:Tr network.speed.info}" />
              </StackPanel>
              <UniformGrid Margin="0,16,0,0" Columns="3">
                <StackPanel>
                  <TextBlock Style="{StaticResource Tag}" Text="{loc:Tr network.speed.downloadLabel}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource MetricHuge}" Text="{Binding Download}" />
                  <TextBlock Style="{StaticResource Caption}" Text="Mbps" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Tag}" Text="{loc:Tr network.speed.uploadLabel}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource MetricHuge}" Text="{Binding Upload}" />
                  <TextBlock Style="{StaticResource Caption}" Text="Mbps" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Tag}" Text="{loc:Tr network.speed.latencyLabel}" />
                  <TextBlock Margin="0,4,0,0" Style="{StaticResource MetricHuge}" Text="{Binding Latency}" />
                  <TextBlock Style="{StaticResource Caption}" Text="ms" />
                </StackPanel>
              </UniformGrid>
              <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding SpeedStatus}" Visibility="{Binding SpeedStatus, Converter={StaticResource StringToVis}}" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Command="{Binding SpeedTestCommand}" Content="{loc:Tr network.speed.button}" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
            </StackPanel>
          </ContentControl>
          <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr network.reset.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr network.reset.title}" Summary="{loc:Tr network.reset.info}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr network.reset.hint}" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding ResetStatus}" Visibility="{Binding ResetStatus, Converter={StaticResource StringToVis}}" />
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource DangerButton}" Command="{Binding ResetNetworkCommand}" Content="{loc:Tr network.reset.button}" IsEnabled="{Binding IsResetting, Converter={StaticResource InverseBool}}" />
            </StackPanel>
          </ContentControl>
        </StackPanel>
        <ContentControl Grid.Column="2" VerticalAlignment="Top" Padding="0" Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="18,16">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr network.ping.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr network.ping.title}" Summary="{loc:Tr network.ping.info}" />
              </StackPanel>
              <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding PingAllCommand}" Content="{loc:Tr network.ping.button}" IsEnabled="{Binding IsPinging, Converter={StaticResource InverseBool}}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Pings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="18,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="{Binding Target.Host}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value}">
                          <FrameworkElement.Style>
                            <Style BasedOn="{StaticResource Metric}" TargetType="{x:Type TextBlock}">
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding HasResult}">
                                  <Setter Property="Foreground" Value="{Binding Quality, Converter={StaticResource RiskToBrush}}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Tag}" Text="{Binding Detail}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ContentControl>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>