<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.SoftwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ContentControl VerticalAlignment="Top" Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr software.install.title}" />
              <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr software.install.title}" Summary="{loc:Tr software.info}" />
            </StackPanel>
            <Button Padding="10,5" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Content="{loc:Tr common.refresh}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr software.install.desc}" />
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Margin="0,0,0,4" Style="{StaticResource Tag}" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox VerticalAlignment="Center" Style="{StaticResource AccentCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBool}}" />
                          <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource StringToVis}}" />
                          </StackPanel>
                          <Border Grid.Column="2" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource GoodBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource GoodBrush}" Text="{loc:Tr software.badge.installed}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Margin="0,16,0,0" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Command="{Binding InstallSelectedCommand}" Content="{loc:Tr software.installSelected}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>
      </ContentControl>
      <StackPanel Grid.Column="2">
        <ContentControl Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr software.upgrades.title}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr software.upgrades.desc}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr software.unavailable}" Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
            <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Text="{Binding ProgressLine}" Visibility="{Binding ProgressLine, Converter={StaticResource StringToVis}}" />
            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckUpgradesCommand}" Content="{loc:Tr software.checkUpgrades}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
              <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Command="{Binding UpgradeAllCommand}" Content="{loc:Tr software.upgradeAll}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding HasUpgrades, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Margin="0,14,0,0" Style="{StaticResource Tag}" Text="{Binding UpgradesSummary}" Visibility="{Binding HasUpgrades, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Upgrades}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" Margin="0,8,0,0" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding VersionLabel}" />
                        <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource StringToVis}}" />
                      </StackPanel>
                      <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,5" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Command="{Binding DataContext.UpgradeOneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{loc:Tr software.update}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding CanUpdateAlone, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ContentControl>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>