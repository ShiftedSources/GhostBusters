<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.CleanupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:views="clr-namespace:GhostEye.App.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" Padding="0,0,8,0">
      <StackPanel>
        <ContentControl Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
              <TextBlock Style="{StaticResource H2}" Text="{loc:Tr cleanup.title}" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding EmptyMessage}" Visibility="{Binding EmptyMessage, Converter={StaticResource StringToVis}}" />
              <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Content="{loc:Tr common.startScan}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>
        </ContentControl>
        <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:CleanupCategoryViewModel}">
                <Grid Margin="0,11">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center" Style="{StaticResource AccentCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  <StackPanel Grid.Column="1" Margin="14,0">
                    <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Description}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" Text="{Binding Warning}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Metric}" Text="{Binding SizeLabel}" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Tag}" Text="{Binding FileCountLabel}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ContentControl>
        <Border Height="16" Background="#00FFFFFF" />
      </StackPanel>
    </ScrollViewer>
    <ContentControl Grid.Row="1" Margin="0,0,8,18" Padding="18,14" Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Style="{StaticResource MetricLarge}" Text="{Binding SelectedLabel}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" Text="{Binding ResultMessage}" Visibility="{Binding ResultMessage, Converter={StaticResource StringToVis}}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Command="{Binding CleanCommand}" Content="{loc:Tr common.cleanNow}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </Grid>
    </ContentControl>
  </Grid>
</UserControl>