<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:svc="clr-namespace:GhostEye.App.Services" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryFilterViewModel}">
              <ToggleButton Margin="0,0,8,8" Padding="14,7" Style="{StaticResource ChipToggle}" Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Id}" IsChecked="{Binding IsSelected, Mode=OneWay}">
                <TextBlock Style="{StaticResource Body}" Text="{Binding Label}" />
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="1" Margin="12,0,0,8" VerticalAlignment="Top" Padding="14,7" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" Content="{loc:Tr history.clear}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding HasAny, Converter={StaticResource BoolToVis}}" />
      </Grid>
      <ContentControl Margin="0,8,0,0" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.empty}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
          <TextBlock Margin="0,0,0,10" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
          <ItemsControl AlternationCount="2147483647" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ChangeSetViewModel}">
                <StackPanel>
                  <Border Margin="0,12,0,14">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource RowDivider}" TargetType="{x:Type Border}">
                        <Style.Triggers>
                          <DataTrigger Value="0" Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Border>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <WrapPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Text="{Binding Title}" />
                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}" Visibility="{Binding IsPartiallyReverted, Converter={StaticResource BoolToVis}}">
                          <TextBlock Style="{StaticResource Tag}" Foreground="{StaticResource WarnBrush}" Text="{Binding PartialLabel}" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{Binding Meta}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                      <Button Padding="12,8" Style="{StaticResource GhostButton}" Command="{Binding ToggleDetailsCommand}" Content="{Binding DetailsLabel}" />
                      <Button Margin="8,0,0,0" Padding="14,8" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding RestoreLabel}" IsEnabled="{Binding CanRestore}" />
                      <Button Margin="8,0,0,0" Padding="10,8" Style="{StaticResource GhostButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{loc:Tr history.delete}">
                        <Viewbox Width="15" Height="15">
                          <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Border Margin="0,12,0,0" Padding="16,12" Background="{StaticResource PanelSunkBrush}" CornerRadius="{StaticResource ControlRadius}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:ChangeRecordViewModel}">
                            <StackPanel Margin="0,4,0,8">
                              <WrapPanel>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Text="{Binding Name}" />
                                <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" BorderThickness="1" CornerRadius="{StaticResource BadgeRadius}">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Setter Property="BorderBrush" Value="{StaticResource GoodBrush}" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding IsReverted}">
                                          <Setter Property="BorderBrush" Value="{StaticResource TextDimBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                  <TextBlock Text="{Binding StatusLabel}">
                                    <FrameworkElement.Style>
                                      <Style BasedOn="{StaticResource Tag}" TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding IsReverted}">
                                            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                  </TextBlock>
                                </Border>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding RevertedAtLabel}" Visibility="{Binding RevertedAtLabel, Converter={StaticResource StringToVis}}" />
                              </WrapPanel>
                              <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr history.detail.none}" Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVis}}" />
                              <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type svc:ChangeDetailLine}">
                                    <Grid Margin="0,3,0,0">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Margin="0,0,16,0" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Text="{Binding Target}" />
                                      <TextBlock Grid.Column="1" FontFamily="{StaticResource FontMono}" FontSize="11.5" TextAlignment="Right">
                                        <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding Before, Mode=OneWay}" /> <Run Foreground="{StaticResource TextDimBrush}" Text="{Binding HasAfter, Mode=OneWay, Converter={StaticResource ArrowIfTrue}}" /> <Run Foreground="{StaticResource AccentBrightBrush}" Text="{Binding After, Mode=OneWay}" /></TextBlock>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Style="{StaticResource RowDivider}" Margin="0,4,0,8" />
                      <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding SafetyLabel}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>