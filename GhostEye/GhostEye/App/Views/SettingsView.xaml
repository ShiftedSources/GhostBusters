<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <ContentControl VerticalAlignment="Top" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr settings.preferences}" />
            <StackPanel Margin="0,18,0,0">
              <TextBlock Style="{StaticResource BodyStrong}" Text="{loc:Tr settings.language}" />
              <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:Tr settings.language.desc}" />
              <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding LanguageOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:LanguageOptionViewModel}">
                    <ToggleButton Margin="0,0,8,8" Padding="16,9" Style="{StaticResource ChipToggle}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                      <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding DisplayName}" />
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Border Style="{StaticResource RowDivider}" Margin="0,18,0,0" />
            <Grid Margin="0,16,0,0">
              <StackPanel Margin="0,0,70,0">
                <TextBlock Style="{StaticResource BodyStrong}" Text="{loc:Tr settings.snow}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:Tr settings.snow.desc}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Text="{loc:Tr settings.snow.autoOff}" Visibility="{Binding SnowAutoOff, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" IsChecked="{Binding SnowEnabled, Mode=TwoWay}" />
            </Grid>
            <Border Style="{StaticResource RowDivider}" Margin="0,16,0,0" />
            <Grid Margin="0,16,0,0">
              <StackPanel Margin="0,0,70,0">
                <TextBlock Style="{StaticResource BodyStrong}" Text="{loc:Tr settings.notifications}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:Tr settings.notifications.desc}" />
              </StackPanel>
              <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
            </Grid>
            <Border Style="{StaticResource RowDivider}" Margin="0,16,0,0" />
            <Grid Margin="0,16,0,0">
              <StackPanel Margin="0,0,70,0">
                <TextBlock Style="{StaticResource BodyStrong}" Text="{loc:Tr settings.restorePoint}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:Tr settings.restorePoint.desc}" />
              </StackPanel>
              <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" IsChecked="{Binding AutoRestorePoint, Mode=TwoWay}" />
            </Grid>
            <Border Style="{StaticResource RowDivider}" Margin="0,16,0,0" />
            <Grid Margin="0,16,0,0">
              <StackPanel Margin="0,0,70,0">
                <TextBlock Style="{StaticResource BodyStrong}" Text="{loc:Tr settings.startWithWindows}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Text="{loc:Tr settings.startWithWindows.desc}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentDimBrush}" TextWrapping="Wrap" Text="{Binding StartupManagedHint}" Visibility="{Binding StartupManagedByWindows, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            </Grid>
            <Border Style="{StaticResource RowDivider}" Margin="0,16,0,0" />
            <Grid Margin="0,16,0,0">
              <StackPanel Margin="0,0,70,0">
                <TextBlock Style="{StaticResource BodyStrong}" Text="{loc:Tr settings.background}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr settings.background.desc}" />
              </StackPanel>
              <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentToggle}" IsChecked="{Binding RunInBackground, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </ContentControl>
        <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <StackPanel Margin="0,0,60,0">
                <TextBlock Style="{StaticResource H2}" Text="{loc:Tr maintenance.title}" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr maintenance.desc}" />
              </StackPanel>
              <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AccentToggle}" IsChecked="{Binding MaintenanceEnabled, Mode=TwoWay}" />
            </Grid>
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
              <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{loc:Tr maintenance.every}" />
              <Button Padding="10,5" CommandParameter="7" Style="{StaticResource GhostButton}" Command="{Binding SetMaintenanceIntervalCommand}" Content="{loc:Tr maintenance.weekly}" />
              <Button Margin="6,0,0,0" Padding="10,5" CommandParameter="14" Style="{StaticResource GhostButton}" Command="{Binding SetMaintenanceIntervalCommand}" Content="{loc:Tr maintenance.biweekly}" />
              <Button Margin="6,0,0,0" Padding="10,5" CommandParameter="30" Style="{StaticResource GhostButton}" Command="{Binding SetMaintenanceIntervalCommand}" Content="{loc:Tr maintenance.monthly}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Metric}" Text="{Binding MaintenanceIntervalDays, StringFormat='{}{0} d'}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Text="{Binding LastMaintenanceLabel}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding MaintenanceMessage}" Visibility="{Binding MaintenanceMessage, Converter={StaticResource StringToVis}}" />
            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Command="{Binding RunMaintenanceNowCommand}" Content="{loc:Tr maintenance.runNow}" IsEnabled="{Binding IsMaintenanceBusy, Converter={StaticResource InverseBool}}" />
          </StackPanel>
        </ContentControl>
        <ContentControl Margin="0,16,0,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr profile.title}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr profile.desc}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding ProfileMessage}" Visibility="{Binding ProfileMessage, Converter={StaticResource StringToVis}}" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
              <Button Style="{StaticResource GhostButton}" Command="{Binding ExportProfileCommand}" Content="{loc:Tr profile.export}" IsEnabled="{Binding IsProfileBusy, Converter={StaticResource InverseBool}}" />
              <Button Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ImportProfileCommand}" Content="{loc:Tr profile.import}" IsEnabled="{Binding IsProfileBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Text="{loc:Tr profile.cli}" />
          </StackPanel>
        </ContentControl>
        <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Margin="18,16,18,4">
              <TextBlock Style="{StaticResource H2}" Text="{loc:Tr settings.thirdParty.title}" />
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr settings.thirdParty.desc}" />
            </StackPanel>
            <ItemsControl Margin="0,8,0,8" ItemsSource="{Binding ThirdPartyLicenses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ThirdPartyLicenseViewModel}">
                  <StackPanel>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="18,9">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}">
                          <Run Text="{Binding License, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Url, Mode=OneWay}" /></TextBlock>
                      </StackPanel>
                      <ToggleButton Grid.Column="1" Padding="10,6" Style="{StaticResource ChipToggle}" Content="{loc:Tr settings.thirdParty.show}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                    </Grid>
                    <TextBox MaxHeight="260" Margin="18,0,18,12" FontSize="11" IsReadOnly="True" Style="{StaticResource AccentTextBox}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Text, Mode=OneWay}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ContentControl>
      </StackPanel>
      <ContentControl Grid.Column="2" Width="340" VerticalAlignment="Top" Style="{StaticResource Card}">
        <StackPanel>
          <Image Width="72" Height="72" HorizontalAlignment="Center" Source="../Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource H2}" Text="GhostEye" />
          <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Tag}" Text="{Binding Version}" />
          <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}" TextAlignment="Center" Text="{Binding Tagline}" />
          <Border Style="{StaticResource RowDivider}" Margin="0,18,0,0" />
          <StackPanel Margin="0,16,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr app.developedBy}" />
            <TextBlock Margin="0,3,0,0" Style="{StaticResource BodyStrong}" Foreground="{StaticResource AccentBrush}" Text="{Binding Developer}" />
          </StackPanel>
          <StackPanel Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr app.website}" />
            <Button Margin="0,3,0,0" Style="{StaticResource LinkButton}" Command="{Binding OpenWebsiteCommand}" Content="{Binding Website}" ToolTip="{loc:Tr app.website.tooltip}" />
          </StackPanel>
        </StackPanel>
      </ContentControl>
    </Grid>
  </ScrollViewer>
</UserControl>