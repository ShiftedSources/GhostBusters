<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GhostEye.App.Views.DiskView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GhostEye.App.Controls" xmlns:loc="clr-namespace:GhostEye.App.Localization" xmlns:vm="clr-namespace:GhostEye.App.ViewModels" x:Name="Page" xmlns:views="clr-namespace:GhostEye.App.Views">
  <ScrollViewer Padding="0,0,8,20">
    <StackPanel>
      <ContentControl Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr disk.map.title}" />
            <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr disk.map.title}" Summary="{loc:Tr disk.map.info}" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Tr disk.map.hint}" />
          <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Drives}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                <Button Width="240" Margin="0,0,10,10" Padding="14,12" HorizontalContentAlignment="Stretch" Style="{StaticResource GhostButton}" Command="{Binding DataContext.AnalyzeDriveCommand, ElementName=Page}" CommandParameter="{Binding}">
                  <StackPanel Width="208">
                    <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Label}" />
                    <ContentControl Margin="0,8,0,0" Style="{StaticResource MeterBar}" Tag="{Binding UsedRatio}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="{Binding UsageLabel}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Command="{Binding AnalyzeProfileCommand}" Content="{loc:Tr disk.map.profile}" />
        </StackPanel>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}" Visibility="{Binding CurrentFolder, Converter={StaticResource StringToVis}}">
        <StackPanel>
          <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding GoUpCommand}" Content="{loc:Tr disk.map.up}" IsEnabled="{Binding CanGoUp}" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" Text="{Binding CurrentFolder}" />
              <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Text="{Binding MapStatus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding CancelMapCommand}" Content="{loc:Tr common.cancel}" Visibility="{Binding IsMapping, Converter={StaticResource BoolToVis}}" />
              <Button Margin="6,0,0,0" Padding="10,6" Style="{StaticResource GhostButton}" Command="{Binding ShowInExplorerCommand}" Content="{loc:Tr common.openLocation}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Bars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:FolderBarViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <Button Padding="18,9" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.OpenBarCommand, ElementName=Page}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="{loc:Tr disk.map.openHint}">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="#00FFFFFF">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Value="{StaticResource AccentWashBrush}" Property="Border.Background" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Control.Template>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="60" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding FilesLabel}" />
                      </StackPanel>
                      <ContentControl Grid.Column="1" Height="10" VerticalAlignment="Center" Style="{StaticResource MeterBar}" Tag="{Binding Ratio}" />
                      <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource Metric}" Text="{Binding SizeLabel}" />
                      <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource Caption}" Text="{Binding ShareLabel}" />
                    </Grid>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ContentControl>
      <ContentControl Margin="0,16,0,0" Padding="0" Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="18,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2}" Text="{loc:Tr disk.dup.title}" />
                <controls:InfoTip Margin="8,0,0,0" Header="{loc:Tr disk.dup.title}" Summary="{loc:Tr disk.dup.info}" />
              </StackPanel>
              <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Text="{Binding DupStatus}" Visibility="{Binding DupStatus, Converter={StaticResource StringToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource GhostButton}" Command="{Binding CancelDuplicatesCommand}" Content="{loc:Tr common.cancel}" Visibility="{Binding IsSearchingDuplicates, Converter={StaticResource BoolToVis}}" />
              <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding FindDuplicatesCommand}" Content="{loc:Tr disk.dup.button}" IsEnabled="{Binding IsSearchingDuplicates, Converter={StaticResource InverseBool}}" />
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding Duplicates}" Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                <StackPanel>
                  <Border Style="{StaticResource RowDivider}" />
                  <TextBlock Margin="18,10,18,4" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DuplicateFileViewModel}">
                        <Grid Margin="18,3,18,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox VerticalAlignment="Center" Style="{StaticResource AccentCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Text="{Binding Folder}" ToolTip="{Binding Folder}" />
                          <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Tag}" Text="{Binding DateLabel}" />
                          <Button Grid.Column="3" Padding="8,4" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenDuplicateCommand, ElementName=Page}" CommandParameter="{Binding}" Content="{loc:Tr common.openLocation}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="8" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="18,12,18,16" Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding DuplicateSelectionLabel}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Command="{Binding DeleteDuplicatesCommand}" Content="{loc:Tr disk.dup.delete}" />
          </Grid>
        </StackPanel>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>