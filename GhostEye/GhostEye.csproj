<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GhostEye</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <Nullable>annotations</Nullable>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="GhostEye.Tools.PresentMon.exe" />
    <EmbeddedResource Include="GhostEye.Tools.PresentMon.exe" LogicalName="GhostEye.Tools.PresentMon.exe" />
    <ApplicationDefinition Remove="GhostEye\App\App.xaml" />
    <ApplicationDefinition Include="GhostEye\App\App.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="app.xaml" />
    <Page Remove="GhostEye\App\Controls\InfoTip.xaml" />
