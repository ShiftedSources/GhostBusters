  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GhostEye.Core\GhostEye.Core.csproj" />
    <ProjectReference Include="..\GhostEye.Infrastructure\GhostEye.Infrastructure.csproj" />
    <ProjectReference Include="..\GhostEye.Backup\GhostEye.Backup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The exported view models already contain their generated MVVM members. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" ExcludeAssets="analyzers;build;buildTransitive" />
  </ItemGroup>
  <Target Name="RemoveExportedMvvmGenerators" BeforeTargets="CoreCompile;GenerateTemporaryTargetAssembly">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'CommunityToolkit.Mvvm.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
