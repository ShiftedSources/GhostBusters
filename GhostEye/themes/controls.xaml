<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:GhostEye.App.Converters">
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="Card" TargetType="{x:Type ContentControl}">
    <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Border BorderThickness="1" SnapsToDevicePixels="True" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineSoftBrush}" CornerRadius="{StaticResource PanelRadius}">
            <Grid>
              <Border Height="1" Margin="16,0" VerticalAlignment="Top" Background="{StaticResource HairlineBrush}" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CardSunk" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Border BorderThickness="1" SnapsToDevicePixels="True" Background="{StaticResource PanelSunkBrush}" BorderBrush="{StaticResource LineBrush}" CornerRadius="{StaticResource ControlRadius}">
            <Grid>
              <Border Height="1" Margin="12,0" VerticalAlignment="Top" Background="{StaticResource HairlineBrush}" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RowDivider" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource LineSoftBrush}" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="{StaticResource FontBodySemi}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="Bd" BorderThickness="1.25" CornerRadius="{StaticResource ControlRadius}">
              <Border.Background>
                <SolidColorBrush Opacity="0" Color="{StaticResource Accent}" />
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource Accent}" />
              </Border.BorderBrush>
              <UIElement.Effect>
                <DropShadowEffect x:Name="Glow" BlurRadius="20" Opacity="0" ShadowDepth="0" Color="{StaticResource Accent}" />
              </UIElement.Effect>
              <Grid>
                <Border Height="1" Margin="10,0" VerticalAlignment="Top" Background="{StaticResource HairlineStrongBrush}" />
                <Grid Name="ContentHost">
                  <UIElement.RenderTransform>
                    <TranslateTransform />
                  </UIElement.RenderTransform>
                  <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource AccentBrush}" />
                </Grid>
              </Grid>
            </Border>
            <Border Name="FocusRing" Margin="-3" BorderThickness="1.5" CornerRadius="13" Opacity="0" BorderBrush="{StaticResource AccentBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource AccentBright}" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Effect.Opacity" To="0.38" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" To="0.06" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource Accent}" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Effect.Opacity" To="0" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" To="0" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ContentHost" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Bd" Property="Border.Background">
                <Setter.Value>
                  <SolidColorBrush Opacity="0.14" Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="UIElement.Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.35" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GhostButton" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="{StaticResource FontBodyMedium}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="Bd" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
              <Border.Background>
                <SolidColorBrush Color="{StaticResource PanelSunk}" />
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource Line}" />
              </Border.BorderBrush>
              <Grid>
                <Border Height="1" Margin="10,0" VerticalAlignment="Top" Background="{StaticResource HairlineBrush}" />
                <Grid Name="ContentHost">
                  <UIElement.RenderTransform>
                    <TranslateTransform />
                  </UIElement.RenderTransform>
                  <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextBrush}" />
                </Grid>
              </Grid>
            </Border>
            <Border Name="FocusRing" Margin="-3" BorderThickness="1.5" CornerRadius="13" Opacity="0" BorderBrush="{StaticResource AccentBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource LineHover}" Duration="{StaticResource MotionFast}" />
                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource PanelHover}" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource Line}" Duration="{StaticResource MotionFast}" />
                    <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource PanelSunk}" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ContentHost" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="UIElement.Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.35" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
            <Border.Background>
              <SolidColorBrush Opacity="0" Color="{StaticResource Danger}" />
            </Border.Background>
            <Border.BorderBrush>
              <SolidColorBrush Opacity="0.55" Color="{StaticResource Danger}" />
            </Border.BorderBrush>
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="18" Opacity="0" ShadowDepth="0" Color="{StaticResource Danger}" />
            </UIElement.Effect>
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource DangerBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)" To="1" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" To="0.08" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Effect.Opacity" To="0.3" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Opacity)" To="0.55" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" To="0" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Effect.Opacity" To="0" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.3" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Background="#00FFFFFF" Padding="{TemplateBinding Control.Padding}">
            <StackPanel>
              <ContentPresenter Name="Content" HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
              <Border Name="Underline" Height="1" Margin="0,1,0,0" Background="{TemplateBinding Control.Foreground}" Opacity="0" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Underline" Property="UIElement.Opacity" Value="0.7" />
              <Setter TargetName="Content" Property="UIElement.Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Content" Property="UIElement.Opacity" Value="0.6" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Background="#00FFFFFF">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource PanelHoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AccentToggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid Width="44" Height="24" Background="#00FFFFFF">
            <Border Name="Track" CornerRadius="12" BorderThickness="1">
              <Border.Background>
                <SolidColorBrush Opacity="0" Color="{StaticResource Accent}" />
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource Line}" />
              </Border.BorderBrush>
            </Border>
            <Border Name="TrackFloor" CornerRadius="12" Panel.ZIndex="-1" Background="{StaticResource PanelSunkBrush}" />
            <Ellipse Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0">
              <Shape.Fill>
                <SolidColorBrush Color="{StaticResource TextDim}" />
              </Shape.Fill>
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0" ShadowDepth="0" Color="{StaticResource Accent}" />
              </UIElement.Effect>
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="KnobShift" />
              </UIElement.RenderTransform>
            </Ellipse>
            <Border Name="FocusRing" Margin="-3" BorderThickness="1.5" CornerRadius="15" Opacity="0" BorderBrush="{StaticResource AccentBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
                    <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource AccentBright}" Duration="{StaticResource MotionFast}" />
                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource Accent}" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" To="0.14" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Effect.Opacity" To="0.8" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" />
                    <ColorAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" To="{StaticResource TextDim}" Duration="{StaticResource MotionFast}" />
                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="{StaticResource Line}" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)" To="0" Duration="{StaticResource MotionFast}" />
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Effect.Opacity" To="0" Duration="{StaticResource MotionFast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="TrackFloor" Property="Border.Background" Value="{StaticResource PanelHoverBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="UIElement.Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.3" />
              <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentCheck" TargetType="{x:Type CheckBox}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Width="22" Height="22" Background="#00FFFFFF">
            <Border Name="Box" CornerRadius="6" BorderThickness="1.25">
              <Border.Background>
                <SolidColorBrush Opacity="0" Color="{StaticResource Accent}" />
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource Line}" />
              </Border.BorderBrush>
            </Border>
            <Path Name="Tick" Data="M4,10 L8.5,14.5 L17,5.5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" Stroke="{StaticResource AccentBrightBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Tick" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="Box" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Box" Property="Border.Background">
                <Setter.Value>
                  <SolidColorBrush Opacity="0.12" Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource LineHover}" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border Name="Bd" Padding="12,10" CornerRadius="{StaticResource ChipRadius}">
              <Border.Background>
                <SolidColorBrush Opacity="0" Color="{StaticResource Accent}" />
              </Border.Background>
              <ContentPresenter Name="Content" VerticalAlignment="Center" TextElement.FontSize="13" TextElement.FontFamily="{StaticResource FontBodyMedium}" TextElement.Foreground="{StaticResource TextDimBrush}" />
            </Border>
            <Border Name="Indicator" Width="3" Margin="-10,7,0,7" HorizontalAlignment="Left" CornerRadius="2" Opacity="0" Background="{StaticResource AccentBrush}">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.9" ShadowDepth="0" Color="{StaticResource Accent}" />
              </UIElement.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background">
                <Setter.Value>
                  <SolidColorBrush Color="#FFFFFF" Opacity="0.035" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Indicator" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
              <Setter TargetName="Bd" Property="Border.Background">
                <Setter.Value>
                  <SolidColorBrush Opacity="0.08" Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChipToggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Bd" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource PanelSunk}" />
            </Border.Background>
            <Border.BorderBrush>
              <SolidColorBrush Color="{StaticResource Line}" />
            </Border.BorderBrush>
            <Grid>
              <Border Height="1" Margin="10,0" VerticalAlignment="Top" Background="{StaticResource HairlineBrush}" />
              <ContentPresenter Margin="{TemplateBinding Control.Padding}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource LineHover}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Bd" Property="Border.Background">
                <Setter.Value>
                  <SolidColorBrush Opacity="0.07" Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Bd" Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="0" Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentTextBox" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bd" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource PanelSunk}" />
            </Border.Background>
            <Border.BorderBrush>
              <SolidColorBrush Color="{StaticResource Line}" />
            </Border.BorderBrush>
            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource LineHover}" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Border.BorderBrush">
                <Setter.Value>
                  <SolidColorBrush Color="{StaticResource Accent}" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <conv:RatioToStarConverter x:Key="MeterRatio" />
  <Style x:Key="MeterBar" TargetType="{x:Type ContentControl}">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContentControl}">
          <Border CornerRadius="3" Background="{StaticResource PanelSunkBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MeterRatio}}" />
                <ColumnDefinition Width="{Binding Tag, ConverterParameter=rest, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MeterRatio}}" />
              </Grid.ColumnDefinitions>
              <Border Background="{TemplateBinding Control.Foreground}" CornerRadius="3" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TextBoxPlaceholder" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="UIElement.Opacity" Value="0.7" />
    <Setter Property="Margin" Value="14,0,14,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SlimThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="Bd" Width="5" CornerRadius="3" Background="{StaticResource LineHoverBrush}" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource AccentDimBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="9" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource SlimThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollViewer}" TargetType="{x:Type ScrollViewer}">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border BorderThickness="1" CornerRadius="8" Padding="10,7" Background="{StaticResource PanelSunkBrush}" BorderBrush="{StaticResource LineBrush}">
            <ContentPresenter TextElement.FontSize="12" TextElement.FontFamily="{StaticResource FontBody}" TextElement.Foreground="{StaticResource TextBrush}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>