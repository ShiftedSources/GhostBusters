<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="Bg0">#09070F</Color>
  <Color x:Key="Bg1">#100B1A</Color>
  <Color x:Key="Panel">#171022</Color>
  <Color x:Key="PanelSunk">#130D1D</Color>
  <Color x:Key="PanelHover">#1C142A</Color>
  <Color x:Key="Line">#271C3A</Color>
  <Color x:Key="LineSoft">#1E1630</Color>
  <Color x:Key="LineHover">#3B2B56</Color>
  <Color x:Key="Accent">#B44DFE</Color>
  <Color x:Key="AccentBright">#D8A8FF</Color>
  <Color x:Key="AccentDim">#6E4E96</Color>
  <Color x:Key="Text">#EBE6F5</Color>
  <Color x:Key="TextDim">#9A90AC</Color>
  <Color x:Key="Warn">#E8B158</Color>
  <Color x:Key="Danger">#E2685F</Color>
  <Color x:Key="Good">#5FD3A3</Color>
  <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}" />
  <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}" />
  <SolidColorBrush x:Key="PanelSunkBrush" Color="{StaticResource PanelSunk}" />
  <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHover}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
  <SolidColorBrush x:Key="LineSoftBrush" Color="{StaticResource LineSoft}" />
  <SolidColorBrush x:Key="LineHoverBrush" Color="{StaticResource LineHover}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBright}" />
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource Good}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#8C0B0714" />
  <SolidColorBrush x:Key="AccentWashBrush" Opacity="0.10" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentWashStrongBrush" Opacity="0.16" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="DangerWashBrush" Opacity="0.10" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="#FFFFFF" Opacity="0.05" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FFFFFF" Opacity="0.10" />
  <LinearGradientBrush x:Key="ScoreArcBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource AccentBright}" />
    <GradientStop Offset="1" Color="#8B3FD4" />
  </LinearGradientBrush>
  <CornerRadius x:Key="PanelRadius">14</CornerRadius>
  <CornerRadius x:Key="ControlRadius">10</CornerRadius>
  <CornerRadius x:Key="ChipRadius">8</CornerRadius>
  <CornerRadius x:Key="BadgeRadius">5</CornerRadius>
  <Thickness x:Key="PanelPadding">20</Thickness>
  <Thickness x:Key="RowPadding">18,13</Thickness>
  <system:Double x:Key="MotionMs" xmlns:system="clr-namespace:System;assembly=System.Private.CoreLib">140</system:Double>
  <Duration x:Key="MotionFast">0:0:0.14</Duration>
  <Duration x:Key="MotionPage">0:0:0.18</Duration>
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
</ResourceDictionary>