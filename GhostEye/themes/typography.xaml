<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="FontBodyMedium">pack://application:,,,/Assets/Fonts/#Inter Medium</FontFamily>
  <FontFamily x:Key="FontBodySemi">pack://application:,,,/Assets/Fonts/#Inter SemiBold</FontFamily>
  <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Space Grotesk Light</FontFamily>
  <FontFamily x:Key="FontMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono Medium</FontFamily>
  <Style x:Key="H1" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="H2" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="Body" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="BodyStrong" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Body}">
    <Setter Property="FontFamily" Value="{StaticResource FontBodySemi}" />
  </Style>
  <Style x:Key="Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="TextBlock.LineHeight" Value="16" />
  </Style>
  <Style x:Key="Metric" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="MetricLarge" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Metric}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style x:Key="MetricHuge" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Metric}">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style x:Key="Tag" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
</ResourceDictionary>